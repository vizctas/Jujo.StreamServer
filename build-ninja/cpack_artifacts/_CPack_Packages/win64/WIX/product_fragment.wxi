<?xml version="1.0" encoding="UTF-8"?>

<Include xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Property Id="ALLUSERS" Value="1"/>
    <Property Id="ARPSYSTEMCOMPONENT" Value="1"/>
    <Property Id="LEGACY_SUNSHINE_PRESENT" Secure="yes">
        <RegistrySearch Id="SearchLegacySunshine64" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Root="HKLM" Type="raw" Win64="yes"/>
        <RegistrySearch Id="SearchLegacySunshine32" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="DisplayName" Root="HKLM" Type="raw"/>
    </Property>
    <Property Id="LEGACY_SUNSHINE_UNINSTALL" Secure="yes">
        <RegistrySearch Id="SearchLegacySunshineUninstall64" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="UninstallString" Root="HKLM" Type="raw" Win64="yes"/>
        <RegistrySearch Id="SearchLegacySunshineUninstall32" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Sunshine" Name="UninstallString" Root="HKLM" Type="raw"/>
    </Property>
    <Property Id="REMOVEVIRTUALDISPLAYDRIVER" Secure="yes" Value="0"/>
    <Property Id="REMOVECLIENTMICDRIVER" Secure="yes" Value="0"/>
    <Property Id="INSTALL_SUDOVDA" Secure="yes" Value="1"/>
    <Property Id="INSTALL_CLIENT_MIC_DRIVER" Secure="yes" Value="1"/>
    <Property Id="SKIP_REMOVE_CONFLICTING_PRODUCTS" Secure="yes" Value="0"/>
    <Condition Message="Administrator privileges are required.">Privileged
    </Condition>
    <Property Id="VIGEMBUS_PRESENT">
        <RegistrySearch Id="Search_ViGEmBus_Service64" Key="SYSTEM\CurrentControlSet\Services\ViGEmBus" Name="DisplayName" Root="HKLM" Type="raw" Win64="yes"/>
        <RegistrySearch Id="Search_ViGEmBus_Service32" Key="SYSTEM\CurrentControlSet\Services\ViGEmBus" Name="DisplayName" Root="HKLM" Type="raw"/>
    </Property>
    <Feature Absent="disallow" Id="JujoStreamServerExtras" Level="1" Title="Jujo.Stream Server Components">
        <ComponentRef Id="JujoServerSvc"/>
        <ComponentRef Id="Fw_Exceptions"/>
        <ComponentRef Id="StartMenuShortcut"/>
        <ComponentRef Id="SudoVdaRegistryDefaults"/>
        <ComponentRef Id="VBCableRegistryDefaults"/>
        <ComponentRef Id="ArpCustomUninstallEntry"/>
    </Feature>
    <InstallExecuteSequence>
        <Custom Action="RemoveConflictingProducts" After="InstallInitialize">NOT Installed AND NOT REMOVE AND SKIP_REMOVE_CONFLICTING_PRODUCTS&lt;&gt;&quot;1&quot;
        </Custom>
        <Custom Action="SetKillProcsQuietImmediate" Before="InstallValidate">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="KillProcsQuietImmediate" After="SetKillProcsQuietImmediate">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="SetStopSvcQuietImmediate" After="KillProcsQuietImmediate">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="StopSvcQuietImmediate" After="SetStopSvcQuietImmediate">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="SetStopSvcQuiet" After="InstallInitialize">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="StopSvcQuiet" After="SetStopSvcQuiet">(Installed AND NOT REMOVE AND UILevel&lt;5) OR (REMOVE = &quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE)
        </Custom>
        <Custom Action="SetStartSvcQuiet" Before="InstallFinalize">Installed AND NOT REMOVE AND UILevel&lt;5
        </Custom>
        <Custom Action="StartSvcQuiet" Before="InstallFinalize">Installed AND NOT REMOVE AND UILevel&lt;5
        </Custom>
        <Custom Action="SetKillProcsQuiet" After="StopSvcQuiet">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE
        </Custom>
        <Custom Action="KillProcsQuiet" After="SetKillProcsQuiet">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE
        </Custom>
        <Custom Action="SetRemoveServiceQuiet" After="KillProcsQuiet">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE
        </Custom>
        <Custom Action="RemoveServiceQuiet" After="SetRemoveServiceQuiet">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE
        </Custom>
        <Custom Action="SetResetAcls" After="InstallFiles">NOT REMOVE
        </Custom>
        <Custom Action="ResetAcls" After="SetResetAcls">NOT REMOVE
        </Custom>
        <Custom Action="SetInstallSudovda" After="ResetAcls">NOT REMOVE AND INSTALL_SUDOVDA = &quot;1&quot;
        </Custom>
        <Custom Action="InstallSudovda" After="SetInstallSudovda">NOT REMOVE AND INSTALL_SUDOVDA = &quot;1&quot;
        </Custom>
        <Custom Action="SetInstallVbCable" After="InstallSudovda">NOT REMOVE AND INSTALL_CLIENT_MIC_DRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="InstallVbCable" After="SetInstallVbCable">NOT REMOVE AND INSTALL_CLIENT_MIC_DRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="SetMigrateConfig" After="InstallVbCable">NOT REMOVE
        </Custom>
        <Custom Action="MigrateConfig" After="SetMigrateConfig">NOT REMOVE
        </Custom>
        <Custom Action="SetRunInstallerMigrations" After="MigrateConfig">NOT REMOVE
        </Custom>
        <Custom Action="RunInstallerMigrations" After="SetRunInstallerMigrations">NOT REMOVE
        </Custom>
        <Custom Action="SetInstallGamepad" After="RunInstallerMigrations">NOT REMOVE AND NOT VIGEMBUS_PRESENT
        </Custom>
        <Custom Action="InstallGamepad" After="SetInstallGamepad">NOT REMOVE AND NOT VIGEMBUS_PRESENT
        </Custom>
        <Custom Action="SetUpdatePathAdd" After="InstallGamepad">NOT REMOVE
        </Custom>
        <Custom Action="UpdatePathAdd" After="SetUpdatePathAdd">NOT REMOVE
        </Custom>
        <Custom Action="SetRestoreNvPrefsUndo" Before="RemoveFiles">REMOVE=&quot;ALL&quot;
        </Custom>
        <Custom Action="RestoreNvPrefsUndo" After="SetRestoreNvPrefsUndo">REMOVE=&quot;ALL&quot;
        </Custom>
        <Custom Action="SetUninstallSudovda" After="RestoreNvPrefsUndo">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="UninstallSudovda" After="SetUninstallSudovda">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVEVIRTUALDISPLAYDRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="SetUninstallVbCable" After="UninstallSudovda">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVECLIENTMICDRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="UninstallVbCable" After="SetUninstallVbCable">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND REMOVECLIENTMICDRIVER = &quot;1&quot;
        </Custom>
        <Custom Action="SetDeleteInstallDir" After="RemoveFiles">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEINSTALLDIR = &quot;1&quot;
        </Custom>
        <Custom Action="DeleteInstallDir" After="SetDeleteInstallDir">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEINSTALLDIR = &quot;1&quot;
        </Custom>
        <Custom Action="SetPruneButConfig" After="RemoveFiles">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEINSTALLDIR&lt;&gt;&quot;1&quot;
        </Custom>
        <Custom Action="PruneButConfig" After="SetPruneButConfig">REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE AND DELETEINSTALLDIR&lt;&gt;&quot;1&quot;
        </Custom>
    </InstallExecuteSequence>
    <InstallUISequence>
        <Custom Action="AskUninstallLegacySunshine" After="AppSearch">LEGACY_SUNSHINE_PRESENT AND UILevel&gt;2 AND NOT Installed
        </Custom>
        <Custom Action="WaitForLegacyUninstall" After="AskUninstallLegacySunshine">UNINSTALL_LEGACY_SUNSHINE = &quot;1&quot; AND NOT USER_CANCELLED_LEGACY_SUNSHINE_UNINSTALL
        </Custom>
        <Custom Action="BlockUserCancelledLegacy" Before="LaunchConditions">USER_CANCELLED_LEGACY_SUNSHINE_UNINSTALL = &quot;1&quot;
        </Custom>
        <Custom Action="BlockLegacySunshineStillPresent" Before="LaunchConditions">LEGACY_SUNSHINE_STILL_PRESENT = &quot;1&quot;
        </Custom>
        <Custom Action="RepairCompletePrompt" After="ExecuteAction">REINSTALL AND NOT REMOVE AND NOT UPGRADINGPRODUCTCODE AND UILevel&gt;2
        </Custom>
    </InstallUISequence>
</Include>