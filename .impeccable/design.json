  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "White pill; one per view.",
      "html": "<button class=\"ds-btn-primary\">Entrar</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:0 22px;border-radius:999px;border:1px solid var(--primary,#F4F5F7);background:var(--primary,#F4F5F7);color:var(--on-primary,#0A0B0F);font:700 16px/1.45 Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif;cursor:pointer;transition:transform 100ms cubic-bezier(.2,0,0,1),background-color 130ms cubic-bezier(.2,0,0,1)}.ds-btn-primary:hover{background:var(--primary-hover,#FFFFFF);border-color:var(--primary-hover,#FFFFFF)}.ds-btn-primary:active{transform:scale(.98);background:var(--primary-press,#E3E5EA)}.ds-btn-primary:focus-visible{outline:3px solid var(--accent,#4C82FF);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Outline pill on a white-alpha fill.",
      "html": "<button class=\"ds-btn\">Cancelar</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 22px;border-radius:999px;border:1px solid var(--line-strong,rgba(255,255,255,.14));background:var(--fill-1,rgba(255,255,255,.04));color:var(--text,#F4F5F7);font:700 16px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif;cursor:pointer;transition:transform 100ms cubic-bezier(.2,0,0,1),background-color 130ms cubic-bezier(.2,0,0,1)}.ds-btn:hover{background:var(--fill-2,rgba(255,255,255,.07))}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:3px solid var(--accent,#4C82FF);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Muted text action.",
      "html": "<button class=\"ds-btn-ghost\">Comprobar de nuevo</button>",
      "css": ".ds-btn-ghost{min-height:48px;padding:0 22px;border-radius:999px;border:1px solid transparent;background:transparent;color:var(--muted,#A3A6AE);font:600 16px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif;cursor:pointer;transition:color 130ms cubic-bezier(.2,0,0,1),transform 100ms cubic-bezier(.2,0,0,1)}.ds-btn-ghost:hover{color:var(--text,#F4F5F7)}.ds-btn-ghost:active{transform:scale(.98)}.ds-btn-ghost:focus-visible{outline:3px solid var(--accent,#4C82FF);outline-offset:2px}"
    },
    {
      "name": "Icon Button",
      "kind": "button",
      "refersTo": "iconbtn",
      "description": "44px circle for top-bar tools.",
      "html": "<button class=\"ds-iconbtn\" aria-label=\"Cerrar\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><path fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" d=\"M6 6l12 12M18 6 6 18\"/></svg></button>",
      "css": ".ds-iconbtn{width:44px;height:44px;display:grid;place-items:center;border-radius:999px;border:1px solid var(--line-strong,rgba(255,255,255,.14));background:var(--fill-2,rgba(255,255,255,.07));color:var(--text,#F4F5F7);cursor:pointer;transition:transform 100ms cubic-bezier(.2,0,0,1),border-color 130ms cubic-bezier(.2,0,0,1)}.ds-iconbtn:hover{background:var(--surface-3,#24272E)}.ds-iconbtn:active{transform:scale(.94)}.ds-iconbtn:focus-visible{outline:3px solid var(--accent,#4C82FF);outline-offset:2px}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field-input",
      "description": "Label above a 52px slate field; accent border + 3px ring on focus.",
      "html": "<label class=\"ds-field\">Correo<input type=\"email\"></label>",
      "css": ".ds-field{display:grid;gap:6px;color:var(--muted,#A3A6AE);font:600 14px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-field input{min-height:52px;padding:0 16px;border-radius:14px;border:1px solid var(--line-strong,rgba(255,255,255,.14));background:var(--surface-2,#1B1D23);color:var(--text,#F4F5F7);font:500 16px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif;caret-color:var(--accent-2,#7FA6FF);transition:border-color 130ms cubic-bezier(.2,0,0,1)}.ds-field input:focus{outline:3px solid var(--accent,#4C82FF);outline-offset:2px;border-color:var(--accent,#4C82FF)}.ds-field input[aria-invalid=true]{border-color:var(--err,#FF5A4F)}"
    },
    {
      "name": "Pills",
      "kind": "chip",
      "refersTo": "pill",
      "description": "Neutral, live and role variants.",
      "html": "<span class=\"ds-pill\">Roguelike</span> <span class=\"ds-pill ds-live\">En curso</span> <span class=\"ds-pill ds-role\">Invitado</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;min-height:28px;padding:0 12px;border-radius:999px;background:var(--fill-2,rgba(255,255,255,.07));color:var(--muted,#A3A6AE);font:600 13px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-live{background:rgba(50,213,131,.14);color:var(--ok,#32D583)}.ds-live::before{content:\"\";width:7px;height:7px;border-radius:50%;background:currentColor}.ds-role{background:var(--accent-soft,rgba(76,130,255,.16));color:var(--accent-2,#7FA6FF)}"
    },
    {
      "name": "Status Pill",
      "kind": "custom",
      "refersTo": "status-pill",
      "description": "Single global toast, bottom-center above the safe area.",
      "html": "<p class=\"ds-status\">Sesión cerrada</p>",
      "css": ".ds-status{display:inline-block;margin:0;padding:10px 16px;border-radius:999px;border:1px solid var(--line-strong,rgba(255,255,255,.14));background:rgba(19,20,24,.96);color:var(--muted,#A3A6AE);font:500 14px Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif}"
    },
    {
      "name": "Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Graphite bottom sheet with grab bar; title 700 -0.01em, muted sub.",
      "html": "<div class=\"ds-sheet\"><div class=\"ds-grab\"></div><h2>Inicia sesión en JUJO.CLOUD</h2><p>Este dispositivo aún no tiene acceso de JUJO.CLOUD. Inicia sesión con tu cuenta.</p></div>",
      "css": ".ds-sheet{max-width:440px;padding:30px 24px 24px;border-radius:24px 24px 0 0;border-top:1px solid var(--line-strong,rgba(255,255,255,.14));background:var(--surface,#131418);color:var(--text,#F4F5F7);text-align:center;box-shadow:0 -8px 32px rgba(10,11,15,.35);font-family:Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif}.ds-grab{width:40px;height:4px;margin:-20px auto 20px;border-radius:999px;background:var(--line-strong,rgba(255,255,255,.14))}.ds-sheet h2{margin:0;font-size:23px;line-height:1.2;font-weight:700;letter-spacing:-.01em}.ds-sheet p{margin:8px auto 0;max-width:34ch;color:var(--muted,#A3A6AE);font-size:15px;line-height:1.45}"
    },
    {
      "name": "Poster",
      "kind": "card",
      "refersTo": "poster-cover",
      "description": "2:3 cover; focus/hover scale 1.06 + 3px ring; title-card fallback shown.",
      "html": "<button class=\"ds-poster\"><span class=\"ds-tc\">Hades II</span></button>",
      "css": ".ds-poster{width:140px;aspect-ratio:2/3;padding:0;border:0;border-radius:10px;overflow:hidden;position:relative;cursor:pointer;background:var(--surface-2,#1B1D23);box-shadow:0 8px 20px rgba(0,0,0,.35);outline:3px solid transparent;outline-offset:2px;transition:transform 130ms cubic-bezier(.2,0,0,1),outline-color 130ms cubic-bezier(.2,0,0,1)}.ds-poster:hover{transform:scale(1.06);outline-color:var(--accent-2,#7FA6FF)}.ds-poster:focus-visible{transform:scale(1.06);outline-color:var(--accent,#4C82FF)}.ds-poster:active{transform:scale(.98)}.ds-tc{position:absolute;inset:0;display:grid;align-content:end;padding:12px;text-align:left;background:linear-gradient(160deg,var(--sky-dusk,#1A1D3D) 0%,var(--surface,#131418) 60%,var(--bg,#0A0B0F) 100%);color:var(--text,#F4F5F7);font:800 14px/1.15 Roboto,system-ui,-apple-system,\"Segoe UI\",sans-serif}"
    },
    {
      "name": "Page Dots",
      "kind": "nav",
      "refersTo": "",
